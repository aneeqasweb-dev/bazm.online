{
  "name": "bazm.online",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run build --workspace @bazm/functions",
    "dev": "next dev",
    "prebuild": "npm run build --workspace @bazm/functions",
