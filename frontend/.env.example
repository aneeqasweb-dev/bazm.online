# Firebase Web SDK configuration (public by Firebase design; still environment-specific)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
NEXT_PUBLIC_APP_URL=

# Enable only after the Google provider and authorized domains are configured.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# Set to true only for local development with the Firebase Emulator Suite.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
