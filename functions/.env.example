# Non-secret server configuration. Copy to a local environment file only for
# development; configure staging/production values in the deployment platform.
APP_URL=https://bazm.online
EMAIL_PROVIDER=HTTP
EMAIL_PROVIDER_ENDPOINT=https://transactional-email-provider.invalid/send
EMAIL_FROM_EMAIL=no-reply@bazm.online
EMAIL_FROM_NAME=Bazm

# Managed secrets are deliberately absent from this file. Set them with:
# firebase functions:secrets:set PAYMENT_WEBHOOK_SECRET
# firebase functions:secrets:set EMAIL_PROVIDER_API_KEY
