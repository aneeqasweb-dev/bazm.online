{
  "name": "@bazm/functions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    "./orders": {
      "types": "./src/orders/order-service.ts",
      "default": "./lib/orders/order-service.js"
    },
    "./payments": {
      "types": "./src/payments/payment-service.ts",
      "default": "./lib/payments/payment-service.js"
    },
    "./returns": {
      "types": "./src/returns/return-service.ts",
      "default": "./lib/returns/return-service.js"
    },
    "./reviews": {
      "types": "./src/reviews/review-service.ts",
      "default": "./lib/reviews/review-service.js"
    },
    "./crm": {
      "types": "./src/crm/crm-service.ts",
      "default": "./lib/crm/crm-service.js"
    },
    "./admin": {
      "types": "./src/admin/admin-service.ts",
      "default": "./lib/admin/admin-service.js"
    },
    "./categories": {
      "types": "./src/categories/category-service.ts",
      "default": "./lib/categories/category-service.js"
    },
    "./inventory": {
      "types": "./src/inventory/inventory-service.ts",
      "default": "./lib/inventory/inventory-service.js"
    },
    "./products": {
      "types": "./src/products/product-service.ts",
      "default": "./lib/products/product-service.js"
    }
  },
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bazm/domain": "*",
    "@opentelemetry/api": "^1.9.1",
    "firebase-admin": "13.10.0",
    "firebase-functions": "^7.3.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.7"
  }
}
